{
  "name": "WEG Assistant",
  "surface": "native-orb",
  "palette": {
    "background": "#0A1828",
    "navy": "#0A2540",
    "accent": "#005DA4",
    "working": "#508EFF",
    "understanding": "#C792EA",
    "approval": "#FFC050",
    "error": "#FF646E"
  },
  "fonts": [
    "JetBrains Mono",
    "Segoe UI"
  ],
  "orb": {
    "defaultSize": 96,
    "frames": 1,
    "fps": 10,
    "persistent": true,
    "doubleClick": "show-chat",
    "singleClick": "hide-chat"
  },
  "panel": {
    "width": 360,
    "height": 540,
    "idleHideSeconds": 60
  },
  "voice": "Espa\u00f1ol, natural, breve y preciso; resultados verificados"
}
